# Copy to .env (gitignored) or export in the shell.
# One vision key is required before `gpsify propose`. Never commit a real key.
# Pick the provider with GPSIFY_VISION_PROVIDER (or --provider) below; each
# provider reads only its own key and never borrows the other's.
XAI_API_KEY=

# Gemini (post-v1 second provider). Use a BILLING-ENABLED key: Gemini has no
# per-request store=False, and free-tier prompts and images may be used to
# improve Google products.
GEMINI_API_KEY=

# Required before public Nominatim calls (`propose` / `review`, later slices).
# Identifiable contact per OSMF Nominatim usage policy.
NOMINATIM_CONTACT=

# Optional overrides (defaults match docs/design.md).
# GPSIFY_MODEL=grok-4.6
# GPSIFY_REASONING=low
# GPSIFY_TIMEOUT_S=600
# GPSIFY_VISION_PROVIDER=xai
# GPSIFY_GEMINI_MODEL=gemini-2.5-flash
# GPSIFY_DATA_DIR=~/.gpsify
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
