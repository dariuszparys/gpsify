{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gpsify",
  "version": "0.2.0",
  "identifier": "com.dariuszparys.gpsify",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gpsify",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#18181b"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; img-src 'self' data: blob: gpsify: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
